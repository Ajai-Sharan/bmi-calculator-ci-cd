{
  "name": "bmi-js-project",
  "version": "1.0.0",
  "description": "BMI calculator HTTP API with CI/CD, Kubernetes deployment and observability",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "branches": 80
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.2",
    "globals": "^17.13.0",
    "jest": "^30.2.0",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "express": "^5.2.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3"
  }
}
